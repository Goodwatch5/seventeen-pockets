# Port the standalone server listens on
PORT=3000

# SQLite database file (parent directory is created automatically)
DATABASE_PATH=./data/app.db

# GitLab personal access token (read_api scope). Without it, Solar Connect
# live pipeline sync is skipped and only manual event ingestion works.
GITLAB_TOKEN=

# Comma-separated GitLab project IDs synced by Solar Connect
GITLAB_PROJECT_IDS=<comma-separated-gitlab-project-ids>

# Minutes between Solar Connect GitLab sync passes
SOLAR_SYNC_INTERVAL_MIN=15
